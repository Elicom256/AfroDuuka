
# Environment files (contain secrets)
.env
.env.*
!.env.example
!.env.production.example

# Render env reference snapshot (contains live secrets)
renderenv.md

# Laravel bootstrap cache (contains serialized env values). The api lives in a
# subdirectory, so the pattern must reach into it — a bare `bootstrap/cache/*.php`
# only matched the repository root and never ignored api/bootstrap/cache.
**/bootstrap/cache/*.php

# CI workflows (tracked in next phase)
.github/workflows
