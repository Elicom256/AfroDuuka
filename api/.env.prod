APP_NAME=InvetoryTracker
APP_ENV=local
APP_KEY=base64:bovNECvMV4dsTl6/Thm+B01i59dV9xMV7cit0UFBTcc=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US                              
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=inventory
DB_USERNAME=elicom
DB_PASSWORD=elicom256
FORWARD_DB_PORT=5432

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============== Email (Amazon SES) ==============
# MAIL_MAILER options: ses | ses-v2 | log | array | fail
MAIL_MAILER=ses-v2
MAIL_FROM_ADDRESS="notifications@duukaflow.com"
MAIL_FROM_NAME="${APP_NAME}"
# Reply-To for all automated customer-facing mail
MAIL_REPLY_TO_ADDRESS="support@duukaflow.com"
# Set to 0 only when the SES account is still in the sandbox (verified recipients only)
MAIL_SES_SANDBOX=false
# Config set used to tag/batch SES sends (optional, blank = none)
MAIL_SES_CONFIGURATION_SET=
# Suppression list applied to bounced/complained addresses
MAIL_SES_SUPPRESSION_LIST_NAME=

# ============== Amazon Web Services ==============
# Used by BOTH the SES mailer and S3 (the SES mailer needs no S3 access).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=af-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Prefer IAM roles / instance profiles over static keys in production
AWS_USE_IAM_ROLE=false

VITE_APP_NAME="${APP_NAME}"

# ============== WhatsApp (Meta Cloud API) ==============
# provider: demo (no network) | meta (WhatsApp Business Cloud API)
WHATSAPP_PROVIDER=demo
WHATSAPP_DEMO_MODE=true
# Graph API version used for the Cloud API. Bump deliberately; deprecate old ones.
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_GRAPH_API_URL=https://graph.facebook.com
# Sender: the WABA phone number id the messages are sent FROM (NOT a phone number)
WHATSAPP_PHONE_NUMBER_ID=
# System-user access token (long-lived). Never a user token.
WHATSAPP_ACCESS_TOKEN=
# Optional: business phone in E.164 for display/logging only
WHATSAPP_BUSINESS_PHONE=+256731794401
# Optional: WABA id, needed for template sync + quality/messaging-limit checks
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Secret you choose; must match the value configured on the Meta webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Public webhook URL Meta will call (no auth, signature verified)
WHATSAPP_WEBHOOK_URL=
# ============== WhatsApp delivery policy ==============
# Business-initiated messages MUST be pre-approved templates (Meta 24h window rule).
# Free text is only allowed for the "send test message" endpoint, and only when true.
WHATSAPP_ALLOW_FREE_TEXT=false
WHATSAPP_DEFAULT_LOCALE=en
WHATSAPP_TEMPLATE_LOCALE=en
# Hard safety rails so a bug can never blow up the messaging quality score
WHATSAPP_MAX_PER_BUSINESS_PER_HOUR=60
WHATSAPP_MAX_PER_BUSINESS_PER_DAY=300
# Low/out-of-stock alert cooldown before a re-arm is required
WHATSAPP_STOCK_ALERT_COOLDOWN_HOURS=24
WHATSAPP_DEFAULT_TEMPLATE=demo_business_alert
# Retry/backoff for transient provider failures (seconds: [delay1, delay2, ...])
WHATSAPP_RETRY_BACKOFF=[30,300,1800]
WHATSAPP_MAX_ATTEMPTS=4

# ============== Email notification policy ==============
# Transactional mail (receipts, invoices, subscription/billing) is never suppressed.
# Preference-checked mail (monthly report, digests) is.
EMAIL_PREFERENCE_CHECKED=true
EMAIL_LIST_UNSUBSCRIBE=true
EMAIL_DIGEST_DAY=1
EMAIL_DIGEST_HOUR=8

# gemini
GEMINI_API_KEY=AQ.Ab8RN6ILKTzy_k7Xa3jAdQ9fcDKn0nSf9MqJuOrSWlwbp-Srug
