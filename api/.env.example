APP_NAME=AfroDuuka
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Set to false in production — prevents stack traces from leaking in error responses
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=inventory
DB_USERNAME=elicom
DB_PASSWORD=elicom256

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Render free tier runs a single web service and no queue worker, so a queued job
# (the verification email is queued after commit) sits in the jobs table and never
# runs. Run jobs synchronously; set back to `database` if a worker is available.
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Resend only delivers to the account owner's address until a domain is verified at
# resend.com/domains, and the from address must be on that domain. Where there is no
# verified domain (e.g. Render free tier), send over SMTP instead. Gmail is the
# quickest to set up: enable 2-Step Verification, create an App password
# (Google Account → Security → App passwords), and put it in MAIL_PASSWORD. An
# ordinary Google password is rejected.
#
# MAIL_FROM_ADDRESS must be the authenticated address — Gmail rewrites or rejects a
# From that does not match the account.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=afroduuka@gmail.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="afroduuka@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend remains an option once a domain is verified:
# MAIL_MAILER=resend
# MAIL_FROM_ADDRESS="onboarding@your-domain.com"
# RESEND_API_KEY=

# Landing-chatbot web retrieval (TinyFish). Server-side only — never expose this in
# the browser. The frontend calls /api/chatbot/* and the key never leaves the server.
TINYFISH_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

BACKUP_DISK=backups
BACKUP_PREFIX=database
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE_TIME=02:00
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"

# WhatsApp simulation
WHATSAPP_PROVIDER=demo
WHATSAPP_DEMO_MODE=true
WHATSAPP_BUSINESS_PHONE=+256731794401
WHATSAPP_PHONE_NUMBER_ID=demo_phone_number_id
WHATSAPP_ACCESS_TOKEN=demo_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=demo_verify_token
WHATSAPP_DEFAULT_TEMPLATE=demo_business_alert

GEMINI_API_KEY=

